# Copy to .env for local development; `pnpm db:start` runs Postgres and storage with these defaults.
PORT=3001
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgres://dnd:dnd@localhost:5432/dnd

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=dnd-content
S3_ACCESS_KEY_ID=dnd-content
S3_SECRET_ACCESS_KEY=dnd-content-secret

# Image generation is off until a key is set.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
