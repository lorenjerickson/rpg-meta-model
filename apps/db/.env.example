# Copy to .env to override the defaults in compose.yaml.
POSTGRES_USER=dnd
POSTGRES_PASSWORD=dnd
POSTGRES_DB=dnd
POSTGRES_PORT=5432

S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY_ID=dnd-content
S3_SECRET_ACCESS_KEY=dnd-content-secret

# How apps connect to the database.
DATABASE_URL=postgres://dnd:dnd@localhost:5432/dnd
