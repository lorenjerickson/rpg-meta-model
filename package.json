{
  "name": "dnd-domain",
  "private": true,
  "description": "A Victorian, steampunk and gothic-horror tabletop system built on D&D 5e (SRD 5.2), with its tools and web app",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "simulate": "pnpm --filter @dnd-domain/system simulate",
    "db:start": "pnpm --filter @dnd-domain/db start",
    "db:stop": "pnpm --filter @dnd-domain/db stop",
    "docker:up": "docker compose up --build --detach --wait",
    "docker:watch": "docker compose up --build --watch",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs --follow",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prettier": "@dnd-domain/config/prettier",
  "devDependencies": {
    "@dnd-domain/config": "workspace:*",
    "prettier": "catalog:",
    "turbo": "catalog:"
  }
}
